# =============================================================================
# RT Knits Maintenance Agent — Environment Variables
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# =============================================================================

# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maintainance_agent

# Anthropic API key for Claude (required)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -----------------------------------------------------------------------------
# Legacy Meta Cloud API fields (required by app/config.py at startup)
# The live WhatsApp path uses whatsapp-web.js (bridge.js), not the Cloud API.
# Set placeholder values so Settings can load successfully.
# -----------------------------------------------------------------------------
WHATSAPP_TOKEN=unused
PHONE_NUMBER_ID=unused
WHATSAPP_VERIFY_TOKEN=unused
